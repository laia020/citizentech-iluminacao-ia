{
  "openapi": "3.1.0",
  "info": {
    "title": "CitizenTech Iluminação IA",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/analisar": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_v1_analisar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Occurrence"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/demo": {
      "get": {
        "summary": "Demo",
        "operationId": "demo_demo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "analise_preliminar",
              "informacao_insuficiente",
              "fora_escopo"
            ],
            "title": "Status"
          },
          "resumo": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Resumo"
          },
          "hipoteses": {
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Hipoteses"
          },
          "informacoes_faltantes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Informacoes Faltantes"
          },
          "encaminhamento": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Encaminhamento"
          },
          "fontes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Fontes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "resumo",
          "hipoteses",
          "informacoes_faltantes",
          "encaminhamento",
          "fontes"
        ],
        "title": "Analysis"
      },
      "AnalysisResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "ocorrencia_id": {
            "type": "string",
            "title": "Ocorrencia Id"
          },
          "analise": {
            "$ref": "#/components/schemas/Analysis"
          },
          "referencias": {
            "items": {
              "$ref": "#/components/schemas/Reference"
            },
            "type": "array",
            "title": "Referencias"
          },
          "execucao": {
            "$ref": "#/components/schemas/Execution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "ocorrencia_id",
          "analise",
          "referencias",
          "execucao"
        ],
        "title": "AnalysisResponse"
      },
      "ErrorResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "codigo": {
            "type": "string",
            "title": "Codigo"
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "codigo",
          "mensagem"
        ],
        "title": "ErrorResponse"
      },
      "Execution": {
        "properties": {
          "modo": {
            "type": "string",
            "enum": [
              "base_sem_contexto",
              "rag_simples",
              "rag_finetuning"
            ],
            "title": "Modo"
          },
          "modelo": {
            "type": "string",
            "title": "Modelo"
          },
          "revisao_modelo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revisao Modelo"
          },
          "adaptador": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptador"
          },
          "versao_base": {
            "type": "string",
            "title": "Versao Base"
          },
          "duracao_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duracao Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "modo",
          "modelo",
          "versao_base",
          "duracao_ms"
        ],
        "title": "Execution"
      },
      "Hypothesis": {
        "properties": {
          "descricao": {
            "type": "string",
            "maxLength": 800,
            "minLength": 1,
            "title": "Descricao"
          },
          "evidencias_observadas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Evidencias Observadas"
          },
          "fontes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Fontes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "descricao",
          "evidencias_observadas",
          "fontes"
        ],
        "title": "Hypothesis"
      },
      "Occurrence": {
        "properties": {
          "ocorrencia_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Ocorrencia Id"
          },
          "pergunta": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Pergunta"
          },
          "municipio": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Municipio"
          },
          "observado_em": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observado Em"
          },
          "simulada": {
            "type": "boolean",
            "title": "Simulada"
          },
          "relato": {
            "type": "string",
            "maxLength": 4000,
            "title": "Relato",
            "default": ""
          },
          "sensores": {
            "items": {
              "$ref": "#/components/schemas/Sensor"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Sensores"
          },
          "observacoes_visuais": {
            "items": {
              "$ref": "#/components/schemas/Visual"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Observacoes Visuais"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ocorrencia_id",
          "pergunta",
          "simulada"
        ],
        "title": "Occurrence"
      },
      "Reference": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "title"
        ],
        "title": "Reference"
      },
      "Sensor": {
        "properties": {
          "tipo": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Tipo"
          },
          "valor": {
            "type": "number",
            "title": "Valor"
          },
          "unidade": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Unidade"
          },
          "calibrado": {
            "type": "boolean",
            "title": "Calibrado"
          },
          "referencia_calibracao": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Referencia Calibracao"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tipo",
          "valor",
          "unidade",
          "calibrado"
        ],
        "title": "Sensor"
      },
      "Visual": {
        "properties": {
          "descricao": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Descricao"
          },
          "confianca": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confianca"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "descricao"
        ],
        "title": "Visual"
      }
    }
  }
}